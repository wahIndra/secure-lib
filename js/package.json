{
  "name": "@wahindra/secure",
  "version": "0.1.0",
  "description": "OWASP Top 10 protection for Node.js: Express middleware (SQL injection, XSS, command injection, path traversal), IDOR guards with any OIDC provider, rate limiting, strict CORS, SSRF guard, password hashing, and a CLI to find vulnerable code and attack your local app.",
  "keywords": [
    "security",
    "owasp",
    "sql-injection",
    "xss",
    "path-traversal",
    "ssrf",
    "access-control",
    "csrf",
    "idor",
    "oidc",
    "keycloak",
    "rate-limit",
    "express",
    "security-scanner"
  ],
  "homepage": "https://github.com/wahIndra/secure-lib#readme",
  "bugs": {
    "url": "https://github.com/wahIndra/secure-lib/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahIndra/secure-lib.git",
    "directory": "js"
  },
  "license": "MIT",
  "author": "Wahyu Indrawan (https://github.com/wahIndra)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./express": {
      "types": "./express.d.ts",
      "default": "./src/express.js"
    },
    "./devtools": {
      "types": "./devtools.d.ts",
      "default": "./src/devtools.js"
    }
  },
  "bin": {
    "secure": "bin/secure.js"
  },
  "files": [
    "src",
    "bin",
    "devtools",
    "index.d.ts",
    "express.d.ts",
    "devtools.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "bench": "node bench/bench.js",
    "prepack": "node -e \"const fs=require('fs');fs.cpSync('../devtools','devtools',{recursive:true});fs.copyFileSync('../LICENSE','LICENSE')\"",
    "postpack": "node -e \"const fs=require('fs');fs.rmSync('devtools',{recursive:true,force:true});fs.rmSync('LICENSE',{force:true})\"",
    "scan": "node bin/secure.js scan"
  }
}
